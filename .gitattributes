# Files excluded from distribution archives.
#
# `export-ignore` applies to `git archive`, which is what GitHub uses to build
# the "Source code (zip)" attached to a release — and that archive is exactly
# what Plugin Update Checker downloads when a site auto-updates. Anything not
# listed here lands inside every customer's wp-content/plugins directory.
#
# Development tooling: never loaded by WordPress, no reason to ship it.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/tools              export-ignore
/composer.json      export-ignore
/composer.lock      export-ignore
/composer.phar      export-ignore
/phpstan.neon       export-ignore
/phpstan-bootstrap.php export-ignore

# Internal notes and build output.
/AUDIT-3.1.2.md     export-ignore
/zips               export-ignore
/.agents            export-ignore

# Note: the reference copy of the competitor plugin needs no rule here — it is
# in .gitignore, so it was never tracked and cannot reach an archive. Paths
# containing spaces or parentheses are not valid .gitattributes patterns.

# Normalise line endings so Windows checkouts don't churn the diff.
* text=auto
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.md  text eol=lf
*.bat text eol=crlf
